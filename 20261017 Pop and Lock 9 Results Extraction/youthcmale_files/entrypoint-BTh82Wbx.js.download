  public_event(id: $event_id) {
    id
    type
    local_start_date
    local_end_date
    location
    country {
      name
    }
    name
    venue_name
    has_discount_codes
    removal_deadline
    refund_rule_conditions {
      valid_until
      keep_percentage
      keep_amount
    }
    league {
      payment_integration {
        merchant_data {
          currency_code
        }
      }
    }
  }
}
