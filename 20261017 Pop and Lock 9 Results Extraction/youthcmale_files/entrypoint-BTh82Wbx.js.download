  cart_requirements(event_id: $event_id, cart: $cart) {
    quotas {
      athlete_id
      category_id
      full
    }

    requirements {
      athlete_id
      category_id

      requirements {
        age {
          registrable
          message
        }

        gender {
          registrable
          message
        }

        licence {
          registrable
          message
        }

        registrable_from_org_quotas {
          registrable
          message
        }

        registration {
          registrable
          message
        }

        max_teams {
          registrable
          message
        }

        max_participants_per_team {
          registrable
          message
        }
      }
    }

    quota_exception_athletes {
      id
      athlete_id
      league_discipline_category {
        id
        discipline_kind
        league_category_id
      }
    }
  }
}
